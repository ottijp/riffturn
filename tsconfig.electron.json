{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "allowJs": false,
    "esModuleInterop": true,
    "incremental": false,
    "isolatedModules": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "./dist/electron",
    "resolveJsonModule": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"],
    "verbatimModuleSyntax": false
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
